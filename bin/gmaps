#!/usr/bin/env bash

# Resolve project root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

case "$1" in
  start)
    echo "Avvio di Google Maps Scraper da ${PROJECT_DIR}..."
    docker compose -f "${PROJECT_DIR}/docker-compose.yml" up -d
    echo "✅ Google Maps Scraper attivo!"
    echo "👉 Apri il browser su: http://localhost:8080"
    ;;
  stop)
    echo "Arresto di Google Maps Scraper..."
    docker compose -f "${PROJECT_DIR}/docker-compose.yml" down
    echo "🛑 Servizio arrestato con successo."
    ;;
  status)
    if docker ps --format '{{.Names}}' | grep -q "^gmaps-ui$"; then
      echo "🟢 In esecuzione su: http://localhost:8080"
    else
      echo "🔴 Fermo (non in esecuzione)"
    fi
    ;;
  logs)
    docker compose -f "${PROJECT_DIR}/docker-compose.yml" logs -f
    ;;
  *)
    echo "Comandi disponibili:"
    echo "  gmaps start   - Avvia la WebUI e il backend scraper via docker-compose"
    echo "  gmaps stop    - Ferma i container"
    echo "  gmaps status  - Verifica lo stato di esecuzione"
    echo "  gmaps logs    - Mostra i log in tempo reale"
    ;;
esac
